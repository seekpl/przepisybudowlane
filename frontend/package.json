{
  "name": "przepisy-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Przepisy budowlane w jednym miejscu — aplikacja PWA (tryb prosty i ekspercki).",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run tokens && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
